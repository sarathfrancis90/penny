{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Penny Offline encrypted portable backup envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "algorithm",
    "nonce",
    "ciphertext",
    "tag"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "algorithm": {
      "const": "AES-256-GCM"
    },
    "nonce": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 16,
      "maxLength": 16
    },
    "ciphertext": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 4,
      "maxLength": 20971520
    },
    "tag": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "minLength": 24,
      "maxLength": 24
    }
  }
}
