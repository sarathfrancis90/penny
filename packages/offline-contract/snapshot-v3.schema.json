        },
        "expenseId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "byteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
